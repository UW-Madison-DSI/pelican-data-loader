{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "deploy",
			"detail": "Rebuild the image and restart demo + postgres, then follow the app log.",
			"type": "shell",
			// The image build runs app/smoke_test.py, so a template or route that
			// cannot render fails here instead of after the containers swap.
			//
			// `logs -f` is the second half on purpose: `up -d` has already
			// detached, so Ctrl+C in this terminal stops the log tail, not the app.
			//
			// Needs the external traefik_network, so this only works in a VS Code
			// window attached to the deploy host.
			"command": "docker compose up -d --build && docker compose logs -f demo",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}
