# The metadata database. The demo app builds its DSN from these; set
# APP_DATABASE_URL instead to point it somewhere else (e.g. sqlite for local dev).
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=default
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

S3_ENDPOINT_URL=https://web.s3.wisc.edu
S3_BUCKET_NAME=pelican-data-loader
S3_ACCESS_KEY_ID=secret
S3_SECRET_ACCESS_KEY=very_secret

PELICAN_URI_PREFIX=pelican://uwdf-director.chtc.wisc.edu/dsi/pytorch
PELICAN_HTTP_URL_PREFIX=https://uwdf-director.chtc.wisc.edu/dsi/pytorch

# Demo web app. APP_SECRET_KEY signs the session cookie: leave it unset and every
# restart discards in-progress publish drafts. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=change_me
# APP_DATABASE_URL=sqlite:///./dev.db
# APP_FAKE_S3=1
